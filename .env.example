# The values previously committed in .env here (a Firebase project key and a
# USERNAME/PASSWORD pair) were unused by the app's code and have been
# removed. Treat them as compromised and rotate them if they're live
# anywhere; see SECURITY_FIX_REPORT.md.

# Supabase — server-only (used by src/lib/supabase.ts and src/pages/api/*).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security, so NEVER prefix
# either of these with NEXT_PUBLIC_ or reference them from client code.
# Get both from Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — public (safe to expose to the browser). Used by the admin
# dashboard (src/lib/supabase-browser.ts, src/lib/supabase-server.ts,
# src/proxy.ts) for Supabase Auth sign-in and for uploading images directly
# from the browser to Storage. NEXT_PUBLIC_SUPABASE_URL is the same project
# URL as SUPABASE_URL above; NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the
# anon/publishable key (Project Settings -> API), never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin dashboard (src/pages/admin/*) — comma-separated email(s) allowed to
# sign in. Every other Supabase Auth user, even a valid signed-in one, is
# rejected. Public sign-ups must also be disabled in Supabase Dashboard ->
# Authentication -> Providers -> Email -> "Allow new users to sign up".
ADMIN_EMAILS=

# Telegram bot used by src/pages/api/enquiry.ts to notify on new leads.
# Create a bot via https://t.me/BotFather to get TG_BOT_TOKEN, add it to the
# target group, and get TG_CHAT_ID via
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending a message
# in the group.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Read by next.config.js and src/lib/constants.ts.
WHATSAPP_NO=
EMAIL=
